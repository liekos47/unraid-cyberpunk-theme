<?php
/* Cyberpunk webGUI theme loader. "Buttons" pages are evaluated on every page,
 * after the built-in theme stylesheet, so these links override it without
 * touching any Unraid file.
 *
 * Palette: PALETTE=<name> (a file in palettes/) or PALETTE=off, read from the
 * plugin's settings file, or from theme.cfg for a manual install.
 * Kill switch: touch /boot/config/plugins/cyberpunk-theme/DISABLED (plugin)
 * or /boot/config/cyberpunk-theme/DISABLED (manual install).
 */
$cpRoot = '/usr/local/emhttp/plugins/cyberpunk-theme';
$cpCfgFile = file_exists('/boot/config/plugins/cyberpunk-theme/cyberpunk-theme.cfg')
  ? '/boot/config/plugins/cyberpunk-theme/cyberpunk-theme.cfg'
  : '/boot/config/cyberpunk-theme/theme.cfg';
$cpCfg = file_exists($cpCfgFile) ? (@parse_ini_file($cpCfgFile) ?: []) : [];
$cpPalette = $cpCfg['PALETTE'] ?? 'netrunner';
if (!preg_match('/^[a-z0-9-]+$/', $cpPalette) || ($cpPalette != 'off' && !file_exists("$cpRoot/palettes/$cpPalette.css"))) $cpPalette = 'netrunner';
$cpDisabled = file_exists('/boot/config/plugins/cyberpunk-theme/DISABLED') || file_exists('/boot/config/cyberpunk-theme/DISABLED');
if (!$cpDisabled && $cpPalette != 'off' && file_exists("$cpRoot/cyberpunk.css")):
  $cpLogo = file_exists("$cpRoot/icons/logo.png") ? 'logo.png' : 'logo.svg';
  $cpFavicons = file_exists("$cpRoot/icons/fav-green-on.png");
?>
<link id="cp-fonts" type="text/css" rel="stylesheet" href="<?autov('/plugins/cyberpunk-theme/fonts.css')?>">
<link id="cp-palette" type="text/css" rel="stylesheet" href="<?autov("/plugins/cyberpunk-theme/palettes/$cpPalette.css")?>">
<link id="cp-main" type="text/css" rel="stylesheet" href="<?autov('/plugins/cyberpunk-theme/cyberpunk.css')?>">
<style id="cp-logo">:root{--cp-logo:url('/plugins/cyberpunk-theme/icons/<?=$cpLogo?>')}</style>
<script>
(function () {
  document.documentElement.classList.add('cp-theme');
<?php if ($cpFavicons): ?>
  // Swap the array-state favicon (green/red/yellow) for your logo in the same state colour.
  var re = /\/webGui\/images\/((green|red|yellow)-on)\.png/;
  function swap(link) {
    var m = (link.getAttribute('href') || '').match(re);
    if (m) link.setAttribute('href', '/plugins/cyberpunk-theme/icons/fav-' + m[1] + '.png');
  }
  var links = document.querySelectorAll('link[rel~="icon"]');
  for (var i = 0; i < links.length; i++) {
    swap(links[i]);
    new MutationObserver(function (ms) { ms.forEach(function (m) { swap(m.target); }); })
      .observe(links[i], { attributes: true, attributeFilter: ['href'] });
  }
<?php endif; ?>
})();
</script>
<?php endif; ?>
