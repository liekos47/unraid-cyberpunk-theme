# Manual install only (the plugin has a settings page instead).
# Copy to /boot/config/cyberpunk-theme/theme.cfg and pick a palette: any file
# in palettes/ without .css (netrunner, relic, phantom-liberty, edgerunner,
# lunar, midnight, neon-night, normandy, n7), or off for the stock Unraid look.
# The next page load uses it; no reinstall needed.
PALETTE=netrunner
